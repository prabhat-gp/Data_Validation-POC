# Copy to backend/.env and fill in YOUR OWN password.
# backend/.env is gitignored -- it never leaves the machine.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password-here

# THREE databases
#   source_db   imported SFDC / Hybris tables + the stg_* staging tables
#   config_db   val_rules + lookups
#   results_db  val_batches / val_runs / val_metrics / val_violations
SOURCE_DB=source_db
CONFIG_DB=config_db
RESULTS_DB=results_db
