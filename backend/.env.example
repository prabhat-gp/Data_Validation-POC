# Copy to backend/.env and fill in YOUR OWN credentials.
# backend/.env is gitignored -- it never leaves your machine.
#
# The repo-root .env is read first, then this file overrides it. So on a
# machine where the MySQL password differs from the committed one, you only
# need DB_PASSWORD here.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password-here

# source_db  -- the b2b* tables being validated (read-only to the app)
# config_db  -- val_rules + lookup tables
# target_db  -- val_batches / val_runs / val_metrics / val_violations / staging
SOURCE_DB=source_db
CONFIG_DB=config_db
TARGET_DB=target_db

# Optional: only if you want to read a Figma palette (figma_palette.py)
# FIGMA_TOKEN=

# Not wired to real systems yet
# SFDC_DB_URL=
# HYBRIS_DB_URL=
